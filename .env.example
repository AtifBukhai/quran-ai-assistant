# --- Grounding / model configuration -----------------------------------------
# LLM backend: "echo" (offline deterministic, default) or "anthropic" (cloud).
QURAN_LLM_BACKEND=echo
# Only needed when QURAN_LLM_BACKEND=anthropic:
ANTHROPIC_API_KEY=
QURAN_LLM_MODEL=claude-3-5-sonnet-latest

# --- Embeddings ---------------------------------------------------------------
# "hash" (offline deterministic, default) or "sentence-transformers".
#
# hash:  char-ngram hashing. No download, fully offline, but NOT semantic — it matches
#        characters, not meaning. Concept/synonym expansion (app/concepts.py) still gives
#        topical recall offline (e.g. "anger" also finds verses about "wrath").
# sentence-transformers:  real multilingual neural embeddings (default model below). Gives
#        true semantic matching across AR/EN/UR. Requires the [ml] extras (torch +
#        sentence-transformers) and a FULL re-ingest so vectors match the model's dimension:
#            pip install -e ".[ml]"
#            QURAN_EMBEDDING_BACKEND=sentence-transformers QURAN_EMBEDDING_DIM=768 \
#              python -m app.ingest.run --full
QURAN_EMBEDDING_BACKEND=hash
QURAN_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# hash -> 384; multilingual-e5-base -> 768. Must match the vectors you ingested.
QURAN_EMBEDDING_DIM=384

# --- Vector store (Qdrant) ----------------------------------------------------
# Leave QURAN_QDRANT_URL empty to use an in-memory Qdrant (no server needed).
QURAN_QDRANT_URL=
QURAN_QDRANT_API_KEY=
QURAN_QDRANT_COLLECTION=quran_verses

# --- Retrieval / confidence gate ----------------------------------------------
QURAN_TOP_K=8
QURAN_TOP_N=5
# Minimum fused score for the best hit; below this -> refuse (low confidence).
QURAN_MIN_SCORE=0.30
# Minimum number of on-topic verses (>= secondary score) required to answer.
QURAN_MIN_EVIDENCE=1
QURAN_SECONDARY_SCORE=0.25
# Weight of the dense (vector) arm in the SEMANTIC blend, 0..1. Defaults adapt to the
# embedding backend: 0.25 for "hash" (strict, lexical-anchored) and 0.55 for
# "sentence-transformers" (lets true semantic matches clear the gate). Set to override.
QURAN_DENSE_WEIGHT=
